#!/usr/bin/env bash
#
# Pre-commit hook: the commit gate. It runs what CI runs
# (.github/workflows/ci.yml): fmt, clippy -D warnings, cargo test, and the
# XPath and XSLT conformance checks in debug mode, which catches the overflow
# and bounds-check panics release mode optimizes away. Change the two
# together. AGENTS.md (Verification) is the rule this enforces: every commit
# that changes code is gate-green, so a reviewer always reviews a tree that
# passed it.
#
# A commit whose staged paths are all Markdown changes no code, and the gate
# is skipped for it. The steps run on the working tree, as CI runs on the
# pushed tree; stage everything you mean to test.
#
# Runs the toolchain rust-toolchain.toml pins (rustup auto-selects it).
# Activate per clone: `git config core.hooksPath .githooks`.

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Gate unless every staged change is to a Markdown file. git answers the
# question itself: --quiet exits 0 when nothing outside `*.md` differs.
# --no-renames reports a rename as a deletion and an addition, so code
# renamed to `.md` still counts, and without --diff-filter a type change
# counts too. (A pipe into `grep -q` would not do: under pipefail the
# writer's SIGPIPE, once grep stops reading, reads as "only Markdown".)
if git diff --cached --quiet --no-renames -- . ':(exclude)*.md'; then
    if ! git diff --cached --quiet; then
        printf 'pre-commit: only Markdown staged, gate skipped\n'
    fi
    exit 0
fi

run_step() {
    local label=$1
    shift
    printf '\n=== pre-commit: %s ===\n' "$label"
    if ! "$@"; then
        printf '\npre-commit: %s FAILED -- commit aborted.\n' "$label" >&2
        exit 1
    fi
}

# Every action a workflow uses is pinned to a commit, the version tag it
# was resolved from in a trailing comment (xbrlstd-rs ADR220, "The
# workflows' own actions"; its tests/l0_gate_filter.rs holds the same
# form there). A line holding a `uses` key — bare, quoted or with a
# space before its colon — that is not
# `uses: <owner>/<repo>[/<path>]@<40 hex> # v<version>` fails, and so
# does a line the grep reads no key from: one opening with YAML's
# explicit key or value indicator (`? uses`, `: ref`) or an alias
# (`*k :`), or holding a double-quoted key with an escape (`"\x75ses":`).
# A longer word ending in `uses` (`statuses: write`) is not the key.
# Whole-line comments pass. Both workflow extensions are read; no
# workflow file, or a grep that fails over one, is a failure.
# Dependabot's pull request is how a pin moves.
check_action_pins() {
    local files nullglob_was key explicit escaped lines status unpinned
    nullglob_was=$(shopt -p nullglob)
    shopt -s nullglob
    files=(.github/workflows/*.yml .github/workflows/*.yaml)
    eval "$nullglob_was"
    if [ "${#files[@]}" -eq 0 ]; then
        printf 'pre-commit: no workflow file under .github/workflows/\n' >&2
        return 1
    fi
    key="(^|[^[:alnum:]_-])['\"]?uses['\"]?[[:space:]]*:"
    explicit="^[[:space:]]*(- )?([?:]( |\$)|\\*)"
    escaped="\"[^\"]*\\\\[^\"]*\"[[:space:]]*:"
    lines=$(grep -n -H -E "$key|$explicit|$escaped" "${files[@]}")
    status=$?
    if [ "$status" -gt 1 ]; then
        printf 'pre-commit: grep failed over the workflow files (exit %s)\n' "$status" >&2
        return 1
    fi
    unpinned=$(printf '%s\n' "$lines" \
        | grep -v -E '^[^:]+:[0-9]+:[[:space:]]*#' \
        | grep -v -E '^[^:]+:[0-9]+:[[:space:]]*(- )?uses: [A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_./-]*@[0-9a-f]{40} # v[0-9]+(\.[0-9]+)*$')
    if [ -n "$unpinned" ]; then
        printf '%s\n' "$unpinned" >&2
        printf 'pre-commit: a workflow line above is not `uses: <owner>/<repo>@<commit> # v<version>`\n' >&2
        return 1
    fi
}
run_step "action pins"              check_action_pins
run_step "cargo fmt --check --all"  cargo fmt --check --all
run_step "cargo clippy -D warnings" cargo clippy --all-targets --all-features -- -D warnings
run_step "cargo test --workspace"   cargo test --workspace
run_step "XPath conformance check"  cargo run --bin xee-testrunner -- check vendor/xpath-tests/
run_step "XSLT conformance check"   cargo run --bin xee-testrunner -- check vendor/xslt-tests/

printf '\npre-commit: all checks passed\n'
